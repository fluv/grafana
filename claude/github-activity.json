{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "github-activity"
  },
  "spec": {
    "title": "GitHub Activity — zuzak repos",
    "description": "Open/closed issue and PR counts for zuzak/claude and zuzak/kube, scraped from the GitHub search API every 60s via github-exporter in the claude namespace.",
    "tags": [
      "claude",
      "github"
    ],
    "timeSettings": {
      "autoRefresh": "5m",
      "from": "now-7d",
      "to": "now",
      "timezone": "browser",
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "cursorSync": "Off",
    "liveNow": false,
    "preload": false,
    "links": [],
    "annotations": [],
    "variables": [],
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Open Issues — claude",
          "description": "Current open issue count in zuzak/claude.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "Prometheus"
                      },
                      "spec": {
                        "expr": "github_issues_open{repo=\"zuzak/claude\"}",
                        "instant": true,
                        "legendFormat": "open issues"
                      }
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.0.1",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {
                  "calcs": ["lastNotNull"],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {"color": "green", "value": null},
                      {"color": "yellow", "value": 20},
                      {"color": "red", "value": 50}
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
