{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "claude-live-session"
  },
  "spec": {
    "title": "Claude Live Session",
    "description": "Live Claude session state scraped from claude-prometheus-exporter (port 9091 on Pi via Alloy). Shows rate-limit usage, context window, consumption rate, and session cost.",
    "tags": ["claude"],
    "timeSettings": {
      "autoRefresh": "10s",
      "from": "now-1h",
      "to": "now",
      "timezone": "browser",
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "cursorSync": "Off",
    "liveNow": false,
    "preload": false,
    "links": [],
    "annotations": [],
    "variables": [],
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "5h Rate Limit",
          "description": "Percentage of the 5-hour token budget consumed.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {"name": "claude-prometheus"},
                      "spec": {"expr": "claude_rl_5h_pct", "instant": true, "legendFormat": "5h used"}
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.0.1",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "min": 0, "max": 100,
                  "color": {"mode": "thresholds"},
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {"color": "green", "value": null},
                      {"color": "blue", "value": 37},
                      {"color": "orange", "value": 63},
                      {"color": "red", "value": 90}
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "5h Window Elapsed",
          "description": "Percentage of the 5-hour window that has elapsed.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {"name": "claude-prometheus"},
                      "spec": {"expr": "claude_rl_5h_time_pct", "instant": true, "legendFormat": "5h elapsed"}
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.0.1",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "min": 0, "max": 100,
                  "color": {"mode": "thresholds"},
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [{"color": "blue", "value": null}]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
