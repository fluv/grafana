          "description": "Claude sessions active in the last 5 minutes.",
          "id": 1,
          "links": [],
          "title": "Active Sessions",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
