                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "claude-prometheus"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "expr": "claude_session_count",
                        "instant": true,
                        "legendFormat": "sessions"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
