{
  "title": "Claude Code Telemetry",
  "uid": "claude-code-telemetry",
  "tags": ["claude"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Summary KPIs",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Spend (USD)",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total[$__range]))",
          "legendFormat": "Cost",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cache Hit Rate",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.85 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_token_usage_tokens_total{type=\"cacheRead\"}[$__range])) / sum(increase(claude_code_token_usage_tokens_total{type=~\"input|cacheRead|cacheCreation\"}[$__range]))",
          "legendFormat": "Cache rate",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sessions",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_session_count_total[$__range]))",
          "legendFormat": "Sessions",
          "instant": true
        }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Active Time",
      "description": "Total active coding time over the selected range",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "color": { "fixedColor": "orange", "mode": "fixed" }
        }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_active_time_seconds_total[$__range])) / 3600",
          "legendFormat": "Active hours",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Commits",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_commit_count_total[$__range]))",
          "legendFormat": "Commits",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Lines Changed",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 }
      },
      "targets": [
        {
          "expr": "sum(increase(claude_code_lines_of_code_count_total[$__range]))",
          "legendFormat": "Lines",
          "instant": true
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Token & Cost Rate",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Token Usage Rate by Type",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "expr": "sum by(type) (rate(claude_code_token_usage_tokens_total[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Cost Rate (USD/hr)",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "expr": "sum by(model) (rate(claude_code_cost_usage_USD_total[5m])) * 3600",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Active Time Rate",
      "description": "Seconds of active time accruing per second, by type",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": ["sum"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true
          }
        }
      },
      "targets": [
        {
          "expr": "sum by(type) (rate(claude_code_active_time_seconds_total[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Cost & Token Trends",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Daily Cost by Model",
      "description": "Cost accrued per model over time. Use with 7d+ range.",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["sum"],
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "barAlignment": 0,
            "lineWidth": 1,
            "stacking": { "group": "A", "mode": "normal" },
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "expr": "sum by(model) (increase(claude_code_cost_usage_USD_total[$__interval]))",
          "legendFormat": "{{model}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Daily Token Usage by Type",
      "description": "Token consumption broken down by type (input, output, cacheRead, cacheCreation). Use with 7d+ range.",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["sum"],
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "barAlignment": 0,
            "lineWidth": 1,
            "stacking": { "group": "A", "mode": "normal" },
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "expr": "sum by(type) (increase(claude_code_token_usage_tokens_total[$__interval]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "Model Breakdown",
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 23,
      "type": "piechart",
      "title": "Cost by Model",
      "gridPos": { "x": 0, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "values": ["value", "percent"]
        },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "sum by(model) (increase(claude_code_cost_usage_USD_total[$__range]))",
          "legendFormat": "{{model}}",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "type": "piechart",
      "title": "Tokens by Model",
      "gridPos": { "x": 8, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "values": ["value", "percent"]
        },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "sum by(model) (increase(claude_code_token_usage_tokens_total[$__range]))",
          "legendFormat": "{{model}}",
          "instant": true
        }
      ]
    },
    {
      "id": 11,
      "type": "piechart",
      "title": "Tokens by Query Source",
      "gridPos": { "x": 16, "y": 32, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "values": ["value", "percent"]
        },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        }
      },
      "targets": [
        {
          "expr": "sum by(query_source) (increase(claude_code_token_usage_tokens_total[$__range]))",
          "legendFormat": "{{query_source}}",
          "instant": true
        }
      ]
    },
    {
      "id": 104,
      "type": "row",
      "title": "Session & Activity",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Daily Sessions",
      "gridPos": { "x": 0, "y": 41, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "barAlignment": 0,
            "lineWidth": 1,
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "expr": "increase(claude_code_session_count_total[$__interval])",
          "legendFormat": "Sessions"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Active Time per Day",
      "gridPos": { "x": 12, "y": 41, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "decimals": 1,
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "barAlignment": 0,
            "lineWidth": 1,
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "expr": "increase(claude_code_active_time_seconds_total[$__interval]) / 3600",
          "legendFormat": "Active hours"
        }
      ]
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Lines of Code Added vs Removed",
      "gridPos": { "x": 0, "y": 49, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "barAlignment": 0,
            "lineWidth": 1,
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "added" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "removed" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        {
          "expr": "increase(claude_code_lines_of_code_count_total{type=\"added\"}[$__interval])",
          "legendFormat": "added"
        },
        {
          "expr": "increase(claude_code_lines_of_code_count_total{type=\"removed\"}[$__interval])",
          "legendFormat": "removed"
        }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Daily Commits",
      "gridPos": { "x": 12, "y": 49, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "barAlignment": 0,
            "lineWidth": 1,
            "spanNulls": false
          }
        }
      },
      "targets": [
        {
          "expr": "increase(claude_code_commit_count_total[$__interval])",
          "legendFormat": "Commits"
        }
      ]
    },
    {
      "id": 105,
      "type": "row",
      "title": "Cache Efficiency",
      "gridPos": { "x": 0, "y": 57, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Cache Hit Rate Over Time",
      "description": "Ratio of cache reads to total input tokens. Higher is better — indicates effective prompt caching.",
      "gridPos": { "x": 0, "y": 58, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.85 }
            ]
          },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(claude_code_token_usage_tokens_total{type=\"cacheRead\"}[1h])) / sum(rate(claude_code_token_usage_tokens_total{type=~\"input|cacheRead|cacheCreation\"}[1h]))",
          "legendFormat": "Cache hit rate"
        }
      ]
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Cache Creation vs Cache Read Tokens",
      "description": "Creation = cold cache (paying to write). Read = warm cache (cheap). Ideally reads >> creation over time.",
      "gridPos": { "x": 12, "y": 58, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "claude-prometheus" },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "spanNulls": true }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(claude_code_token_usage_tokens_total{type=\"cacheCreation\"}[1h]))",
          "legendFormat": "creation (cold)"
        },
        {
          "expr": "sum(rate(claude_code_token_usage_tokens_total{type=\"cacheRead\"}[1h]))",
          "legendFormat": "read (warm)"
        }
      ]
    }
  ]
}
