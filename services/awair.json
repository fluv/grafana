              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "min": 0,
                  "color": {"mode": "palette-classic"},
                  "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "gradientMode": "none", "spanNulls": false},
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {"color": "green", "value": null},
                      {"color": "yellow", "value": 1000},
                      {"color": "orange", "value": 1500},
                      {"color": "red", "value": 2000}
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
