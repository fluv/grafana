{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "awair"
  },
  "spec": {
    "title": "Awair Air Quality",
    "description": "Air quality metrics from three Awair Element monitors (bedroom, lounge, study) via the Lifestyle Prometheus exporter.",
    "tags": ["awair", "air-quality", "lifestyle"],
    "timeSettings": {
      "autoRefresh": "1m",
      "from": "now-24h",
      "to": "now",
      "timezone": "browser",
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "cursorSync": "Crosshair",
    "liveNow": false,
    "preload": false,
    "links": [],
    "annotations": [],
    "variables": [],
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Device status",
          "description": "1 when the device responded to the last poll within 3× the poll interval; 0 on timeout or error.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {"name": "Lifestyle Prometheus"},
                      "spec": {"expr": "awair_up", "instant": true, "legendFormat": "{{location}}"}
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.0.1",
            "spec": {
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "horizontal",
                "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
                "textMode": "auto",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "mappings": [
                    {
                      "type": "value",
                      "options": {
                        "0": {"text": "Down", "color": "red", "index": 0},
                        "1": {"text": "Up", "color": "green", "index": 1}
                      }
                    }
                  ],
                  "color": {"mode": "thresholds"},
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {"color": "red", "value": null},
                      {"color": "green", "value": 1}
                    ]
                  }
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Awair Score",
          "description": "Composite air quality score (0–100). Higher is better. Awair's proprietary weighting of CO2, VOC, PM2.5, temperature, and humidity.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {"name": "Lifestyle Prometheus"},
                      "spec": {"expr": "awair_score", "instant": false, "legendFormat": "{{location}}"}
                    }
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.0.1",
            "spec": {
              "options": {
                "legend": {"calcs": ["lastNotNull", "min"], "displayMode": "list", "placement": "bottom", "showLegend": true},
                "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}
              },
              "fieldConfig": {
                "defaults": {
                  "min": 0,
                  "max": 100,
                  "color": {"mode": "palette-classic"},
                  "custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "gradientMode": "none", "spanNulls": false}
                },
                "overrides": []
              }
            }
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "CO2",
          "description": "CO2 concentration in parts per million. >1000 ppm indicates poor ventilation; >1500 ppm is noticeably stuffy.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "refId": "A",
                    "hidden": false,
